<UserControl x:Class="MajorExpress.Delivery.Api.Client.DesktopApp.Components.Registry.OrderRegistry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cmp="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.Components"
             xmlns:local="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.Components.Registry"
             xmlns:fields="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.Components.Fields"
             xmlns:vm="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.ViewModels.Registry"
             xmlns:svg="https://github.com/dotnetprojects/SVGImage" d:DataContext="{d:DesignInstance Type=vm:OrderRegistryViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">
    <Grid>
        <local:EntityRegistry>
            <local:EntityRegistry.DataView>
                <ListBox
                    ItemsSource="{Binding Orders}"
                    d:ItemsSource="{Binding Orders}"
                    SelectedItem="{Binding SelectionEntity}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="{StaticResource BorderColor}" Background="{StaticResource AccentColor}" CornerRadius="8">
                                <StackPanel Margin="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="8*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Дата создания" FontWeight="Bold" />
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1">
                                            <StackPanel>
                                                <TextBlock Text="Информация о клиенте" FontWeight="Bold" />
                                                <StackPanel Margin="0 2 0 0">
                                                    <fields:CardItem Icon="person" Text="{Binding Client.User.FIO}" />
                                                    <fields:CardItem Icon="phone" Text="{Binding Client.User.PhoneNumber}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Информация о грузе" FontWeight="Bold" Margin="0 10 0 0" />
                                                <StackPanel Margin="0 2 0 0">
                                                    <fields:CardItem Icon="cargo" Text="{Binding Cargo.Description}" />
                                                    <fields:CardItem Icon="size" Text="{Binding Cargo.Size, StringFormat={}{0} м³}" />
                                                    <fields:CardItem Icon="wheight" Text="{Binding Cargo.Weight, StringFormat={}{0} кг}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Status, Converter={StaticResource StatusConverter}}" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="10 0" />

                                        <StackPanel Grid.Column="2" Grid.Row="1">
                                            <StackPanel>
                                                <TextBlock Text="Информация о исполнителе" FontWeight="Bold" />
                                                <StackPanel Margin="0 2 0 0">
                                                    <fields:CardItem Icon="person" Text="{Binding Courier.User.FIO}" />
                                                    <fields:CardItem Icon="phone" Text="{Binding Courier.User.PhoneNumber}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Margin="0 10 0 0">
                                                <TextBlock Text="Дата отправки и причина отмены"  FontWeight="Bold" />
                                                <fields:CardItem Icon="time" Text="{Binding PickupTime, StringFormat=dd.MM.yyyy HH:mm}" />
                                                <fields:CardItem Icon="time" Text="{Binding CancelComment, TargetNullValue=Не указана}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0 10 0 0">
                                        <TextBlock Text="Адреса доставки" FontWeight="Bold" />
                                        <StackPanel Margin="0 2 0 0">
                                            <fields:CardItem Icon="geo" Text="{Binding PickupAddress}" Fill="{StaticResource PickupAddressColor}" />
                                            <fields:CardItem Icon="geo" Text="{Binding DeliveryAddress}" Fill="{StaticResource DeliveryAddressColor}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical" Background="{StaticResource SecondaryColor}" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer>
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </local:EntityRegistry.DataView>
        </local:EntityRegistry>
    </Grid>
</UserControl>
