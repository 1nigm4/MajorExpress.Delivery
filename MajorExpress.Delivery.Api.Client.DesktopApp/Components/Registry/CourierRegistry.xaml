<UserControl x:Class="MajorExpress.Delivery.Api.Client.DesktopApp.Components.Registry.CourierRegistry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.Components.Registry"
             xmlns:vm="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.ViewModels.Registry"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CourierRegistryViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <local:EntityRegistry>
            <local:EntityRegistry.DataView>
                <DataGrid ItemsSource="{Binding Couriers}" SelectedItem="{Binding SelectionEntity}" CanUserAddRows="False" IsReadOnly="True" AutoGenerateColumns="False" ColumnHeaderHeight="30" MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding User.FIO}" />
                        <DataGridTextColumn Header="Номер телефона" Binding="{Binding User.PhoneNumber}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </local:EntityRegistry.DataView>
        </local:EntityRegistry>
    </Grid>
</UserControl>
