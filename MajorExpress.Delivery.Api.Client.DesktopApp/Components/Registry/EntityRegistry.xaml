<UserControl x:Class="MajorExpress.Delivery.Api.Client.DesktopApp.Components.Registry.EntityRegistry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.Components.Registry"
             xmlns:vm="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.ViewModels.Registry"
             x:Name="Root"
             Loaded="Root_Loaded"
             d:DataContext="{d:DesignInstance Type=vm:EntityRegistryViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">
    <Border BorderThickness="1" BorderBrush="{StaticResource BorderColor}" Background="{StaticResource AccentColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Border Padding="5" BorderThickness="0 0 0 1" BorderBrush="{StaticResource BorderColor}">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Border CornerRadius="8" HorizontalAlignment="Left" Background="#FFB9BDC5" >
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" Background="Transparent" BorderThickness="0" Padding="10 4" />
                    </Border>

                    <Border CornerRadius="8" HorizontalAlignment="Left" Background="{StaticResource AccentBtnColor}" Margin="10 0 0 0" >
                        <Button Content="Добавить" Command="{Binding AddCommand}" Background="Transparent" Foreground="{StaticResource AccentColor}" BorderThickness="0" Padding="10 4" />
                    </Border>

                    <Border CornerRadius="8" HorizontalAlignment="Left" Background="#FFB9BDC5" Margin="10 0 0 0" >
                        <Button Content="Редактировать" Command="{Binding EditCommand}" CommandParameter="{Binding SelectionEntity}" Background="Transparent" BorderThickness="0" Padding="10 4" />
                    </Border>

                    <Border CornerRadius="8" HorizontalAlignment="Left" Background="#FFB9BDC5" Margin="10 0 0 0" >
                        <Button Content="Удалить" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectionEntity}" Background="Transparent" BorderThickness="0" Padding="10 4" />
                    </Border>
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataView}" />

            <Border Padding="5" Grid.Row="2" BorderThickness="0 1 0 0" BorderBrush="{StaticResource BorderColor}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Перейти на страницу:" Margin="0 0 10 0" />
                        <TextBox HorizontalAlignment="Left" Text="{Binding PageIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalCount, StringFormat='Всего записей: {0}'}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Показать записей:" Margin="0 0 10 0" />
                        <ComboBox Width="40" ItemsSource="{Binding DisplayQuantityValues}" SelectedItem="{Binding PageSize, Mode=TwoWay}" VerticalContentAlignment="Center" Padding="2 0 0 2" />
                        <TextBox Visibility="Collapsed" HorizontalAlignment="Left" Text="{Binding PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
