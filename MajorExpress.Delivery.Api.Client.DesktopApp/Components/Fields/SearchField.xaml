<UserControl x:Class="MajorExpress.Delivery.Api.Client.DesktopApp.Components.Fields.SearchField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.Components.Fields"
             mc:Ignorable="d"
             x:Name="Root"
             xmlns:svg="https://github.com/dotnetprojects/SVGImage"
             d:DesignHeight="50" d:DesignWidth="800">
    <Grid Height="30">
        <local:TextField InputPadding="25 0 25 2" VerticalAlignment="Top" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <svg:SVGImage
            Width="15"
            Height="15"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Left"
            Source="/MajorExpress.Delivery.Api.Client.DesktopApp;component/Resources/Assets/search.svg"
            Margin="7,0,0,7"
            OverrideFillColor="Transparent"
            OverrideColor="#FF9CA3AF" />
    </Grid>
</UserControl>
