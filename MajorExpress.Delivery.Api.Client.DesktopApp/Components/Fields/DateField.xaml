<UserControl x:Class="MajorExpress.Delivery.Api.Client.DesktopApp.Components.Fields.DateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.Components.Fields"
             x:Name="Root"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="200">
    <Grid DataContext="{Binding ElementName=Root}">
        <local:Field LabelText="{Binding LabelText, ElementName=Root}">
            <local:Field.Slot>
                <xctk:DateTimePicker
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    AllowSpin="False"
                    Format="Custom"
                    ShowButtonSpinner="False"
                    FormatString="dd.MM.yyyy HH:mm"
                    TextAlignment="Left"
                    Text="{Binding Text, Converter={StaticResource DateConverter}}"
                    Padding="5"
                    FontSize="12" />
            </local:Field.Slot>
        </local:Field>
    </Grid>
</UserControl>
