<UserControl x:Class="MajorExpress.Delivery.Api.Client.DesktopApp.Components.Fields.TextField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.Components.Fields"
             xmlns:svg="https://github.com/dotnetprojects/SVGImage"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="200">
    <Grid DataContext="{Binding ElementName=Root}">
        <local:Field x:Name="InnerField" LabelText="{Binding LabelText}">
            <local:Field.Slot>
                <TextBox
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    IsReadOnly="{Binding IsReadonly}"
                    BorderThickness="0"
                    FontSize="16"
                    Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                    Padding="{Binding InputPadding}" />
            </local:Field.Slot>
        </local:Field>
    </Grid>
</UserControl>
