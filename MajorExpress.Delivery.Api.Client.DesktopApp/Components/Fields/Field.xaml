<UserControl x:Class="MajorExpress.Delivery.Api.Client.DesktopApp.Components.Fields.Field"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.Components.Fields"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="200">
    <StackPanel MaxHeight="50">
        <Label
            Content="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Visibility="{Binding LabelVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Target="{Binding ElementName=SlotControl}"
            Padding="0"
            FontWeight="Bold"
            Margin="0 0 0 4" />
        <Border BorderThickness="1" Height="30" BorderBrush="{StaticResource BorderColor}" CornerRadius="8" Background="White">
            <Grid>
                <ContentControl Name="SlotControl" Content="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Slot}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
