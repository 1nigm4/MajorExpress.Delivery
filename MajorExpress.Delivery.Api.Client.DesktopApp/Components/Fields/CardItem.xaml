<UserControl x:Class="MajorExpress.Delivery.Api.Client.DesktopApp.Components.Fields.CardItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.Components.Fields"
             xmlns:svg="https://github.com/dotnetprojects/SVGImage"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Orientation="Horizontal" Height="20">
        <svg:SVGImage
            Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
            OverrideFillColor="{Binding Fill, RelativeSource={RelativeSource AncestorType=UserControl}}"
            OverrideColor="{Binding Color, RelativeSource={RelativeSource AncestorType=UserControl}}"
            HorizontalAlignment="Left" VerticalAlignment="Center"
            Source="{Binding Icon, StringFormat={}/MajorExpress.Delivery.Api.Client.DesktopApp;component/Resources/Assets/{0}.svg, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}" TextTrimming="CharacterEllipsis" Margin="4 0" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
