<Application x:Class="MajorExpress.Delivery.Api.Client.DesktopApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converter="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp.Converters"
             xmlns:local="clr-namespace:MajorExpress.Delivery.Api.Client.DesktopApp">
    <Application.Resources>
        <converter:StatusConverter x:Key="StatusConverter" />
        <converter:DateTimeConverter x:Key="DateConverter" />
        <SolidColorBrush x:Key="PrimaryBtnColor" Color="#176def" />
        <SolidColorBrush x:Key="AccentColor" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SecondaryColor" Color="#FFF9FAFB" />
        <SolidColorBrush x:Key="BorderColor" Color="#FFE5E7EB" />
        <SolidColorBrush x:Key="AccentBtnColor" Color="#FF2563EB" />
        <Color x:Key="PickupAddressColor">#FF3B82F6</Color>
        <Color x:Key="DeliveryAddressColor">#FFEF4444</Color>
    </Application.Resources>
</Application>
